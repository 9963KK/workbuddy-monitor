{
  "name": "workbuddy-monitor",
  "version": "0.1.2",
  "description": "实时监控 WorkBuddy 积分用量与免费用户的 24h 窗口额度：输入框双环徽标 + 设置页面板，支持多账号轮询与免费/付费识别（附可选直连模型供应商）。",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "workbuddy",
    "monitor",
    "credits",
    "quota",
    "usage",
    "provider"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0 <0.3.0"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-llm": ">=0.2.0 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "author": "9963kk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/9963KK/workbuddy-monitor.git"
  },
  "homepage": "https://github.com/9963KK/workbuddy-monitor#readme",
  "bugs": {
    "url": "https://github.com/9963KK/workbuddy-monitor/issues"
  }
}